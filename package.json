{
  "name": "cf-first",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Worker\" -c \"cyan.bold,magenta.bold\" \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "wrangler dev",
    "build": "vue-tsc -b && vite build",
    "preview": "wrangler dev",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8",
    "wrangler": "^3.111.0"
  }
}
