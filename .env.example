# =========================================================================
# AdonisJS 7 + Cloudflare Workers 環境變數配置範本 (.env.example)
# =========================================================================

# 1. 應用程式安全密鑰 (至少 32 個字元，用於 JWT 簽名、Cookie/Session 加密)
APP_KEY=cf-first-super-secret-adonis-app-key-32chars-min

# 2. 伺服器時區 (採用 IANA 時區格式，將由 Luxon 時間模組使用)
APP_TIMEZONE=Asia/Taipei

# 3. 運行環境與通訊埠
NODE_ENV=development
PORT=8787

# 4. 資料庫驅動配置 (可選: d1 | sqlite | postgres | mysql)
DB_CONNECTION=d1

# Cloudflare D1 綁定名稱 (若 DB_CONNECTION=d1)
D1_BINDING=DB

# 關聯式資料庫連線資訊 (若使用外部 MySQL / PostgreSQL / SQLite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_DATABASE=cf_first

# 完整連線字串 (選填，若設定將優先於分項連線參數)
# DATABASE_URL=mysql://root:secret@127.0.0.1:3306/cf_first

# 5. JWT 安全密鑰 (選填，未設定時將自動 fallback 至 APP_KEY)
JWT_SECRET=cf-first-super-secret-jwt-signing-key


